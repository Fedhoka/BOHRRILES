# API
NODE_ENV=development
PORT=4000
DATABASE_URL=file:./data/bohr.db
# For PostgreSQL prod: postgres://user:pass@host:5432/bohr

# Auth
JWT_ACCESS_SECRET=change-me-to-64-byte-random-hex
JWT_REFRESH_SECRET=change-me-to-different-64-byte-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Frontend (Vite reads VITE_*)
VITE_API_URL=http://localhost:4000
