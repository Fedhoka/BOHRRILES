<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.BOHRriles"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MenuActivity" android:screenOrientation="portrait" />
        <activity android:name=".EnvasarActivity" android:screenOrientation="portrait" />
        <activity android:name=".EntregarActivity" android:screenOrientation="portrait" />
        <activity android:name=".RecibirActivity" android:screenOrientation="portrait" />
        <activity android:name=".VaciarActivity" android:screenOrientation="portrait" />
        <activity android:name=".ConsultarActivity" android:screenOrientation="portrait" />
        <activity android:name=".ClientesActivity" android:screenOrientation="portrait" />
        <activity android:name=".EstilosActivity" android:screenOrientation="portrait" />

        <!-- ZXing capture activity -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation"
            xmlns:tools="http://schemas.android.com/tools"/>

    </application>
</manifest>
