# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev): file:./data/bohr.db
# PostgreSQL (prod): postgresql://user:pass@host:5432/bohr
DATABASE_URL=file:./data/bohr.db

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated frontend origins (no trailing slash)
CORS_ORIGIN=https://bohr.vercel.app

# ── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECURE=true
COOKIE_DOMAIN=bohr.app

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
